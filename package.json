    "happy-dom": "^21.0.4",
    "html-webpack-plugin": "^5.6.3",
    "jsdoc": "^4.0.5",
    "jsdom": "^30.1.3",
    "mini-css-extract-plugin": "^2.9.2",
    "style-loader": "^4.0.0",
    "vitest": "^5.0.5",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
